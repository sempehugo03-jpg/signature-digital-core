 import {productImageResolver,readSafePhotograph} from './images.mjs';
@@ -48,5 +49,19 @@ export function createProductModifier({db,principal,...dependencies}) {
   if(!siteRef){const site=await store.first('SELECT site_ref FROM fm_sites WHERE customer_ref=? AND project_ref=?',scope.customer_ref,scope.project_ref);if(!site)throw Error('ENGINE_NOT_FOUND');siteRef=site.site_ref;}
   return adapter.getCurrentRelease(scope,{...args,site_ref:siteRef});
  };
+ // Internal read port only: no new site-change envelope, job or publication.
+ bridge.readCurrentSite=async()=>{
+  const release=await bridge.getCurrentRelease()
+  const site=await store.site(scope,release.site_ref)
+  const row=await store.artifact(release.site_ref,release.version_ref)
+  const pin=await store.first('SELECT html FROM fm_artifacts WHERE site_ref=? AND html LIKE ? LIMIT 1',release.site_ref,ARTIFACT_DERIVED_PREFIX+'%')
+  const artifact=await materializeArtifact(row,JSON.parse(site.config_json),{render_pin:pin?.html.slice(ARTIFACT_DERIVED_PREFIX.length)||null})
+  if(artifact.sha256!==release.sha256)throw Error('ENGINE_ARTIFACT_CORRUPT')
+  if(!publisher?.verify)throw Error('ENGINE_DEPLOYER_NOT_CONNECTED')
+  const stored=await store.release(release.site_ref,release.release_ref)
+  const verified=await publisher.verify({site:JSON.parse(site.config_json),release:JSON.parse(stored.receipt_json),expected_sha256:artifact.sha256})
+  if(verified?.sha256!==artifact.sha256||verified.release_ref!==release.release_ref)throw Error('ENGINE_SERVED_BYTES_MISMATCH')
+  return {...release,html:artifact.html}
+ };
  return Object.freeze(bridge);
 }
