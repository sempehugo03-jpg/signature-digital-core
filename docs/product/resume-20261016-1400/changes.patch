+ assert.equal(h.document.querySelector('.change-current-site').classList.contains('is-mobile'),true);
+ assert.match(h.document.querySelector('#change-feedback').textContent,/publiée et vérifiée/);
+ assert.equal(h.document.querySelector('#change-center').getAttribute('aria-busy'),'false');
+});
