+ assert.ok(h.document.querySelector('.change-live-preview iframe'));assert.equal(reloads,0);
+ h.click('[data-close-preview]');assert.equal(h.document.querySelector('.change-current-site iframe'),frame);assert.equal(reloads,0);
+ assert.equal(h.calls.some(c=>c.method==='POST'),false);
+});
