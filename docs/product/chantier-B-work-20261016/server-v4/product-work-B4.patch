+import {mkdtemp,readFile,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join,resolve} from 'node:path';
+import {sqliteD1} from './helpers.mjs';
+import {productAuth} from '../../product/auth.mjs';
+import {digest} from '../../product/contract.mjs';
+const dir=await mkdtemp(join(tmpdir(),'fabrya-source-contract-'));
+await build({entryPoints:['product/work-mcp.mjs','product/native-work-server.mjs'],outdir:dir,bundle:true,format:'esm',platform:'node',plugins:[{name:'raw',setup(b){b.onResolve({filter:/\?raw$/},a=>({path:resolve(a.resolveDir,a.path.slice(0,-4)),namespace:'raw'}));b.onLoad({filter:/.*/,namespace:'raw'},async a=>({contents:await readFile(a.path,'utf8'),loader:'text'}));}}]});
+const {workMcp,enqueueWorkRequest,NATIVE_WORK_SOURCE_SITE_ID}=await import('file://'+join(dir,'work-mcp.js'));
+const {nativeWorkServer}=await import('file://'+join(dir,'native-work-server.js'));
+const privateOrigin='https://fabrya-product-live-validation.sempehugo03.chatgpt.site';
+const secretBytes=new TextEncoder().encode('local-source-fixture-secret-32bytes'),secret='whsec_'+btoa(String.fromCharCode(...secretBytes));
+async function fixture(){
+ const db=sqliteD1();db.exec=async sql=>db.connection.exec(sql);
+ db.connection.exec(await readFile('product/drizzle/0004_private_delivery_gate.sql','utf8'));
+ db.connection.exec(await readFile('product/native-work-schema.sql','utf8'));
+ db.connection.exec('CREATE TABLE sd_platform_conversations(tracking_token TEXT PRIMARY KEY,user_id TEXT,messages_json TEXT)');
+ db.connection.prepare('INSERT INTO fp_work_mcp_subscriptions VALUES(?,?,?,?,?)').run('sub_source_fixture','operator','https://chatgpt.com/local-source-fixture',secret,Date.now()+600000);
+ const originalFetch=globalThis.fetch,events=[];
+ globalThis.fetch=async(url,init)=>{assert.equal(url,'https://chatgpt.com/local-source-fixture');events.push({raw:init.body,headers:new Headers(init.headers)});return Response.json({});};
+ const env={DB:db,FABRYA_PRODUCT_QA:'true',FABRYA_STRIPE_MODE:'test',FABRYA_NATIVE_WORK_ORIGIN:privateOrigin,FABRYA_NATIVE_WORK_ENABLED:'true',FABRYA_WORK_OPERATOR_ID:'operator',FABRYA_WORK_SOURCE_SITE_ID:'CLIENT_OR_CONFIG_FORGED'};
+ const server=nativeWorkServer({db,env,authorizeWork:async()=> 'operator'});
+ const rpc=(method,params={},native=true)=>{
+  const request=new Request((native?privateOrigin:'https://fabrya-product-qa.sempehugo03.chatgpt.site')+'/mcp',{method:'POST',headers:{'oai-authenticated-user-id':'operator'},body:JSON.stringify({jsonrpc:'2.0',id:1,method,params,source_site_id:'CLIENT_FORGED'})});
+  return (native?server.fetch(request):workMcp(request,{DB:db,FABRYA_PRODUCT_QA:'true',FABRYA_STRIPE_MODE:'test'})).then(r=>r.json());
+ };
+ const tool=(args,native=true)=>rpc('tools/call',{name:'fabrya_work_request_create',arguments:args},native);
+ return {db,env,server,events,rpc,tool,close(){globalThis.fetch=originalFetch;db.close();}};
+}
+async function verifySignature(event){
+ const key=await crypto.subtle.importKey('raw',secretBytes,{name:'HMAC',hash:'SHA-256'},false,['verify']);
+ const signature=Uint8Array.from(atob(event.headers.get('webhook-signature').slice(3)),c=>c.charCodeAt(0));
+ const prefix=event.headers.get('webhook-id')+'.'+event.headers.get('webhook-timestamp')+'.';
+ assert.equal(await crypto.subtle.verify('HMAC',key,signature,new TextEncoder().encode(prefix+event.raw)),true);
+ const forged=event.raw.replace(NATIVE_WORK_SOURCE_SITE_ID,'appgprj_forged_site');
+ if(forged!==event.raw)assert.equal(await crypto.subtle.verify('HMAC',key,signature,new TextEncoder().encode(prefix+forged)),false,'source is covered by original webhook signature');
+}
