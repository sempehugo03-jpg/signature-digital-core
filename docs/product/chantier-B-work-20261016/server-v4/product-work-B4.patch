+  const token='sdp_'+'c'.repeat(32);f.db.connection.prepare('INSERT INTO sd_platform_conversations VALUES(?,?,?)').run(token,account.user.id,JSON.stringify({readyForConfirmation:true,source_site_id:'SAVED_FORGED',draft:{companyName:'Local',businessDescription:'Local contract fixture',goal:'Verify local contract',source_site_id:'DRAFT_FORGED'}}));
+  const request=()=>new Request(privateOrigin+'/api/product/native-work-intake',{method:'POST',headers:{origin:privateOrigin,cookie:account.cookie.split(';')[0]},body:JSON.stringify({startGeneration:true,project:{trackingToken:token,source_site_id:'PROJECT_FORGED'},source_site_id:'BODY_FORGED'})});
+  const response=await f.server.fetch(request());assert.equal(response.status,202);const first=await response.json();
+  assert.equal(f.events.length,1);assert.deepEqual(JSON.parse(f.events[0].raw).data,{request_id:first.work.request_id,attempt:1,source_site_id:NATIVE_WORK_SOURCE_SITE_ID});await verifySignature(f.events[0]);
+  const snapshots=()=>['fp_projects','fp_jobs','fp_versions','fp_work_product_links','fp_work_mcp_requests','fp_work_mcp_deliveries'].map(t=>[t,f.db.connection.prepare('SELECT * FROM '+t).all()]);const before=snapshots();
+  const second=await (await f.server.fetch(request())).json();assert.equal(second.work.request_id,first.work.request_id);assert.equal(second.product.job.job_id,first.product.job.job_id);assert.equal(second.product.project.id,first.product.project.id);assert.equal(f.events.length,1);assert.deepEqual(snapshots(),before);
+ }finally{f.close();}
