+ const f=await fixture();try{
+  const discovery=(await f.rpc('events/list')).result.events[0];
+  assert.equal(discovery.name,'fabrya.demo.requested');assert.deepEqual(discovery.payloadSchema,{type:'object',properties:{request_id:{type:'string'},attempt:{type:'integer',minimum:1},source_site_id:{type:'string',const:NATIVE_WORK_SOURCE_SITE_ID}},required:['request_id','attempt','source_site_id'],additionalProperties:false});
+  const args={brief:JSON.stringify({company:'Local source fixture',source_site_id:'BRIEF_FORGED'}),idempotency_key:'local-source-private-create',source_site_id:'ARGUMENT_FORGED'};
+  const one=(await f.tool(args)).result.structuredContent;
+  assert.ok(one.request_id);assert.equal(one.creation_executed,false);assert.equal(f.events.length,1);
+  const event=JSON.parse(f.events[0].raw);assert.deepEqual(event.data,{request_id:one.request_id,attempt:1,source_site_id:NATIVE_WORK_SOURCE_SITE_ID});
+  assert.equal(event.eventId,'evt_'+one.request_id);assert.equal(event.name,'fabrya.demo.requested');await verifySignature(f.events[0]);
+  const before=f.db.connection.prepare('SELECT * FROM fp_work_mcp_requests').all();
+  const two=(await f.tool(args)).result.structuredContent;assert.equal(two.request_id,one.request_id);assert.equal(f.events.length,1);
+  assert.deepEqual(f.db.connection.prepare('SELECT * FROM fp_work_mcp_requests').all(),before);
+  assert.equal(before[0].brief,args.brief);assert.equal(before[0].method_hash,await digest(await readFile('product/work-creation-method.md','utf8')));
+  assert.deepEqual({...f.db.connection.prepare('SELECT status,attempts,last_error FROM fp_work_mcp_deliveries').get()},{status:'delivered',attempts:1,last_error:null});
+  assert.equal(before[0].lease_hash,null);assert.equal(before[0].lease_until,null);assert.equal(f.env.FABRYA_WORK_SOURCE_SITE_ID,'CLIENT_OR_CONFIG_FORGED');
+ }finally{f.close();}
+});
