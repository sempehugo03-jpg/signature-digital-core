diff --git a/product/native-work-payments.mjs b/product/native-work-payments.mjs
new file mode 100644
index 0000000..94c97aa
--- /dev/null
+++ b/product/native-work-payments.mjs
@@ -0,0 +1,125 @@
+import {stripeGateway,paymentConfiguration} from './stripe-gateway.mjs';
+import {deliveryGate} from './delivery-gate.mjs';
+import {fail} from './contract.mjs';
+
+const fields=['project_id','user_id','version_id','approval_id','checkout_id'];
+const ref=value=>typeof value==='string'?value:value?.id;
+const native=key=>typeof key==='string'&&/^native_work_[a-f0-9]{64}$/.test(key);
+// A scoped port over the existing gateway, not a billing implementation.
+// All provider operations stay TEST; scope comes from SQL, never the return URL.
+export function nativeWorkPayments({db,env,origin,verifier,projectId=null,fetcher}){
+ let scope=projectId;
+ const first=(sql,...args)=>db.prepare(sql).bind(...args).first();
+ const context=async checkoutId=>{
+  const c=await first(`SELECT c.id AS checkout_id,c.project_id,c.stripe_session_id,a.id AS approval_id,a.version_id,a.artifact_hash,p.user_id,p.request_key,p.approved_version_id
+   FROM fp_checkouts c JOIN fp_approvals a ON a.id=c.approval_id AND a.project_id=c.project_id JOIN fp_projects p ON p.id=c.project_id WHERE c.id=?`,checkoutId);
+  if(!c||!native(c.request_key)||!scope||c.project_id!==scope||c.approved_version_id!==c.version_id)fail('PAYMENT_CONTEXT','Contexte du paiement invalide.',409);
+  return c;
+ };
+ const checkMetadata=async object=>{
+  const c=await context(object?.metadata?.checkout_id);
+  if(fields.some(k=>object.metadata?.[k]!==c[k]))fail('PAYMENT_CONTEXT','Contexte du paiement invalide.',409);
+  return c;
+ };
+ const enabled=async()=>{
+  if(env.FABRYA_STRIPE_MODE!=='test'||env.FABRYA_PRODUCT_QA!=='true')fail('LIVE_FORBIDDEN','Paiement TEST uniquement.',503);
+  const config=paymentConfiguration(env,origin); // rejects a LIVE key in the TEST slot before any call
+  if(env.FABRYA_NATIVE_TEST_PAYMENTS_ENABLED!=='true'||!config.key||!config.webhookSecret||env.FABRYA_CREDITS_ENABLED!=='true')
+   fail('NATIVE_WORK_COMMERCE_LOCKED','Paiement TEST en cours de raccordement.',409);
+  for(const name of ['fp_credit_wallets','fp_credit_wallet_project','fp_credit_one_monthly_period','fp_credit_wallet_no_delete','fp_native_activation_binding']){
+   if(!await first('SELECT name FROM sqlite_master WHERE name=?',name))fail('NATIVE_PAYMENT_MIGRATION_REQUIRED','Activation indisponible.',503);
+  }
+ };
+ let base;
+ const gateway=()=>base||(base=stripeGateway({env,origin,fetcher}));
+ const delivery=async c=>{
+  const v=await first('SELECT * FROM fp_versions WHERE id=? AND project_id=?',c.version_id,c.project_id);
+  if(!v||v.artifact_hash!==c.artifact_hash||!(await deliveryGate({db,version:v,approval:{version_id:c.version_id,artifact_hash:c.artifact_hash},verifier})).checkout_allowed)
+   fail('DELIVERY_NOT_VALIDATED','La version doit être vérifiée avant activation.',409);
+ };
+ const subscription=async id=>{
+  const sub=await gateway().getSubscription(id);
+  if(sub.id!==id||sub.livemode!==false)fail('PAYMENT_CONTEXT','Abonnement incorrect.',409);
+  const c=await checkMetadata(sub);
+  const saved=await first('SELECT * FROM fp_subscriptions WHERE project_id=?',scope);
+  if(saved&&(saved.stripe_subscription_id!==id||saved.stripe_customer_id!==ref(sub.customer)))fail('PAYMENT_CONTEXT','Abonnement incorrect.',409);
+  const session=await first('SELECT stripe_session_id FROM fp_checkouts WHERE id=?',c.checkout_id);
+  if(!session?.stripe_session_id)fail('PAYMENT_CONTEXT','Paiement non relié.',409);
+  return sub;
+ };
+ const invoice=async id=>{
+  const value=await gateway().getInvoice(id);
+  if(value.id!==id||value.livemode!==false)fail('PAYMENT_CONTEXT','Facture incorrecte.',409);
+  const sub=await subscription(ref(value.parent?.subscription_details?.subscription||value.subscription));
+  if(ref(value.customer)!==ref(sub.customer))fail('PAYMENT_CONTEXT','Client de la facture incorrect.',409);
+  return value;
+ };
+ const stripe={
+  get priceId(){return gateway().priceId;},get productId(){return gateway().productId;},livemode:false,
+  verifyAccount:async()=>{},verifyOffer:async()=>{await enabled();return gateway().verifyOffer();},
+  validSubscription:sub=>gateway().validSubscription(sub),
+  createSession:async c=>{await enabled();await delivery(await context(c.checkout_id));return gateway().createSession(c);},
+  findCheckout:async c=>{await enabled();await context(c.checkout_id);return gateway().findCheckout(c);},
+  getSession:async id=>{
+   await enabled();const c=await first('SELECT id FROM fp_checkouts WHERE stripe_session_id=? AND project_id=?',id,scope);
+   if(!c)fail('PAYMENT_CONTEXT','Paiement non relié.',409);
+   const value=await gateway().getSession(id),binding=await checkMetadata(value);
+   if(value.id!==id||value.livemode!==false||value.client_reference_id!==scope||binding.stripe_session_id!==id)fail('PAYMENT_CONTEXT','Paiement incorrect.',409);
+   return value;
+  },
+  getSubscription:async id=>{await enabled();return subscription(id);},
+  getInvoice:async id=>{await enabled();return invoice(id);},
+  getSessionsForSubscription:async id=>{
+   await enabled();const sub=await subscription(id),c=await checkMetadata(sub);
+   // Canonical local binding replaces a broad provider list. Never reconcile a foreign checkout.
+   return {data:[{id:c.stripe_session_id}]};
+  },
+  expireSession:async id=>{await stripe.getSession(id);return gateway().expireSession(id);},
+  createPortal:async(customer,project)=>{
+   await enabled();const saved=await first('SELECT * FROM fp_subscriptions WHERE project_id=?',scope);
+   if(project!==scope||!saved||saved.stripe_customer_id!==customer)fail('PAYMENT_CONTEXT','Abonnement incorrect.',409);
+   await subscription(saved.stripe_subscription_id);return gateway().createPortal(customer,project);
+  },
+ };
+ const paymentGuard=async({session,subscription:sub,checkout,approval,project})=>{
+  await enabled();const c=await checkMetadata(sub);await delivery(c);
+  if(project.id!==scope||checkout.id!==c.checkout_id||approval.version_id!==c.version_id||ref(session.subscription)!==sub.id||ref(session.customer)!==ref(sub.customer))fail('PAYMENT_CONTEXT','Activation non reliée.',409);
+  const value=await invoice(ref(sub.latest_invoice));
+  const line=value.lines?.data?.find(x=>(x.price?.id||x.pricing?.price_details?.price)===stripe.priceId);
+  const start=line?.period?.start,end=line?.period?.end;
+  if(value.status!=='paid'||value.paid===false||value.amount_paid!==5900||value.currency!=='eur'||(value.amount_remaining!==undefined&&value.amount_remaining!==0)||
+   (value.amount_paid_off_stripe!==undefined&&value.amount_paid_off_stripe!==0)||!Number.isSafeInteger(start)||!Number.isSafeInteger(end)||end-start<25*86400||end-start>35*86400)
+   fail('CREDIT_INVOICE_INVALID','Facture non vérifiée.',409);
+ };
+ const webhookFilter=async event=>{
+  // Called only AFTER signature verification by the canonical HTTP handler.
+  if(!event||typeof event.id!=='string'||!event.id||typeof event.type!=='string'||!event.data?.object)fail('EVENT_INVALID','Événement invalide.',400);
+  if(event.livemode!==false)fail('LIVE_FORBIDDEN','Événement réel refusé.',400);
+  const object=event.data?.object;
+  let row;
+  if(['checkout.session.completed','checkout.session.async_payment_succeeded','checkout.session.expired'].includes(event.type)){
+   row=await first('SELECT p.id,p.request_key FROM fp_checkouts c JOIN fp_projects p ON p.id=c.project_id WHERE c.stripe_session_id=?',object?.id);
+  }else if(event.type?.startsWith('customer.subscription.')||['invoice.paid','invoice.payment_failed'].includes(event.type)){
+   let subId=event.type.startsWith('invoice.')?ref(object?.parent?.subscription_details?.subscription||object?.subscription):object?.id;
+   row=await first('SELECT p.id,p.request_key FROM fp_subscriptions s JOIN fp_projects p ON p.id=s.project_id WHERE s.stripe_subscription_id=?',subId||'');
+   if(!row){
+    // Out-of-order first invoice/subscription: provider metadata must map to a saved checkout.
+    if(env.FABRYA_NATIVE_TEST_PAYMENTS_ENABLED!=='true')return false;
+    await enabled();
+    if(event.type.startsWith('invoice.')){const inv=await gateway().getInvoice(object?.id);subId=ref(inv.parent?.subscription_details?.subscription||inv.subscription);}
+    if(!subId)return false;
+    const sub=await gateway().getSubscription(subId);
+    row=await first('SELECT p.id,p.request_key FROM fp_checkouts c JOIN fp_projects p ON p.id=c.project_id WHERE c.id=?',sub.metadata?.checkout_id||'');
+    if(row&&native(row.request_key)){
+     scope=row.id;const c=await checkMetadata(sub);
+     const session=await stripe.getSession(c.stripe_session_id);
+     if(ref(session.subscription)!==sub.id)fail('PAYMENT_CONTEXT','Abonnement non relié au paiement.',409);
+    }
+   }
+  }else return false;
+  if(!row)return false;
+  if(!native(row.request_key))return null;
+  scope=row.id;await enabled();return true;
+ };
+ return {stripe,paymentGuard,webhookFilter,enabled};
+}
