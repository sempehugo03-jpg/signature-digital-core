+   if(reason==='wrong_version')receipt.product_version_id='ver_other_fixture';
+   if(reason==='wrong_site')receipt.proof.publisher_readback.site_project_id='appgprj_other_fixture';
+   if(reason==='wrong_hash')receipt.client_artifact_sha256='a'.repeat(64);
