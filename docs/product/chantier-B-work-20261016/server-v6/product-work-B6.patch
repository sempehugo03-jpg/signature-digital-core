+function localReview(data,user){
+ return {operation:'review',request_id:data.link.request_id,product_version_id:data.link.version_id,product_project_id:data.link.project_id,product_user_id:user.id,artifact_sha256:data.hash,site_change_baseline:data.proof.site_change_baseline,
+  desktop:{status:'PASS',cases:[{name:'SYNTHETIC desktop transport contract only',pass:true}],evidence:'In-memory fixture, no actual browser observation'},
+  mobile:{status:'PASS',cases:[{name:'SYNTHETIC mobile transport contract only',pass:true}],evidence:'In-memory fixture, no actual browser observation'}};
+}
+async function localPreviewOnly(f){
+ const state=await f.create(),data=await f.prepare(state),p='/api/product/projects/'+data.link.project_id;
+ data.proof.delivery_mode='preview_only';data.proof.desktop.status='NOT_VERIFIED';data.proof.mobile.status='NOT_VERIFIED';
+ const done=await f.rpc('fabrya_work_request_complete',{...data.args,proof:JSON.stringify(data.proof)});assert.equal(done.structuredContent.status,'completed');
+ return {state,data,p};
+}
+test('native review recognizes only the authorized canonical review of the exact preview_only original artifact',async()=>{
+ const f=await fixture({strictD1:true});try{
+  const {data,p}=await localPreviewOnly(f),originalReceipt=f.db.connection.prepare('SELECT result FROM fp_work_mcp_requests').get().result;
+  assert.equal((await f.server().fetch(f.req(p+'/approve','POST',{version_id:data.link.version_id,reviewed:true}))).status,409,'client flag cannot replace review');
+  assert.equal((await f.server().fetch(f.req(p+'/versions/'+data.link.version_id+'/preview'))).status,200);
+  const before=f.db.connection.prepare('SELECT * FROM fp_versions').all();
+  const review=await f.rpc('fabrya_work_request_complete',{...data.args,lease:data.hash,proof:JSON.stringify(localReview(data,f.a.user))});assert.equal(review.structuredContent?.status,'verified');
+  const repeated=await f.rpc('fabrya_work_request_complete',{...data.args,lease:data.hash,proof:JSON.stringify(localReview(data,f.a.user))});assert.equal(repeated.structuredContent.already_reviewed,true);
+  assert.equal(f.db.connection.prepare('SELECT result FROM fp_work_mcp_requests').get().result,originalReceipt,'original preview_only receipt must remain immutable');
+  assert.equal(JSON.parse(originalReceipt).delivery_qualification,'preview_only');
+  assert.deepEqual(f.db.connection.prepare('SELECT * FROM fp_versions').all(),before);
+  assert.equal((await f.server().fetch(f.req(p+'/approve','POST',{version_id:data.link.version_id}))).status,200,'canonical authorized review must lift only the delivery gate');
+  const state=await (await f.server().fetch(f.req(p))).json();assert.equal(state.delivery.checkout_allowed,true);
+  assert.equal((await f.server().fetch(f.req(p+'/checkout','POST'))).status,409,'B6 must not open Stripe without its own validated transport');
+  assert.equal(f.eventSends(),1);assert.equal(f.count('fp_jobs'),1);assert.equal(f.count('fp_versions'),1);assert.equal(f.count('fp_work_delivery_reviews'),1);assert.equal(f.count('fp_subscriptions'),0);assert.equal(f.count('fp_activations'),0);assert.equal(f.siteCommands(),0);
+ }finally{f.close();}
+});
+test('native review cannot be replaced by client consent, missing real-QA evidence, wrong scope or unavailable writer',async()=>{
+ const f=await fixture({strictD1:true});try{
+  const {data,p}=await localPreviewOnly(f),valid=localReview(data,f.a.user);
+  let r=await f.rpc('fabrya_work_request_complete',{...data.args,lease:data.hash,proof:JSON.stringify(valid)});assert.equal(r.isError,true,'owner must first open actual artifact');
+  assert.equal(f.count('fp_work_delivery_reviews'),0);
+  await f.server().fetch(f.req(p+'/versions/'+data.link.version_id+'/preview'));
+  for(const reason of ['mobile_unverified','missing_evidence','foreign_user','foreign_version','wrong_hash','wrong_site','no_writer']){
+   const proof=JSON.parse(JSON.stringify(valid)),args={...data.args,lease:data.hash};
+   if(reason==='mobile_unverified')proof.mobile.status='NOT_VERIFIED';
+   if(reason==='missing_evidence')delete proof.desktop.evidence;
+   if(reason==='foreign_user')proof.product_user_id=f.b.user.id;
+   if(reason==='foreign_version')proof.product_version_id='ver_foreign_fixture';
+   if(reason==='wrong_hash')args.artifact_sha256='a'.repeat(64);
+   if(reason==='wrong_site')args.site_project_id='appgprj_foreign_fixture';
+   if(reason==='no_writer')delete f.env['FABRYA_ENGINE_SITE_'+f.site+'_WRITE_SECRET'];
+   r=await f.rpc('fabrya_work_request_complete',{...args,proof:JSON.stringify(proof)});assert.equal(r.isError,true,reason);
+   assert.equal(f.count('fp_work_delivery_reviews'),0);assert.equal((await f.server().fetch(f.req(p+'/approve','POST',{version_id:data.link.version_id,reviewed:true}))).status,409);
+  }
+  assert.equal(f.count('fp_approvals'),0);assert.equal(f.count('fp_checkouts'),0);assert.equal(f.siteCommands(),0);
+ }finally{f.close();}
+});
