+   assert.equal((await f.server().fetch(f.req(p+'/approve','POST',{version_id:data.link.version_id,reviewed:true}))).status,409,reason);
+   assert.equal(f.count('fp_approvals'),0);assert.equal(f.db.connection.prepare('SELECT result FROM fp_work_mcp_requests').get().result,original);assert.equal(f.siteCommands(),0);
+  }finally{f.close();}
