+   if(reason==='foreign_preview')f.db.connection.prepare('UPDATE fp_work_client_previews SET user_id=?').run(f.b.user.id);
+   if(reason==='changed_version_bytes')f.db.connection.prepare('UPDATE fp_versions SET html=?').run('<!doctype html><p>Different artifact</p>');
