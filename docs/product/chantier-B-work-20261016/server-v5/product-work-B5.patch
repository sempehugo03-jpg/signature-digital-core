+// Canonical Work schemas only: one full statement per prepared query. D1 exec
+// splits on newlines, so it cannot safely receive multiline CREATE statements.
+// Migration-owned objects already present are never recreated on reads.
+const initialized=new WeakMap(),migrationOwned=new WeakSet();
+// The native private composition uses Sites-managed migrations. A missing
+// object is an explicit failure there, never an implicit migration on read.
+export function useMigratedWorkSchema(db){if(db&&typeof db==='object')migrationOwned.add(db);}
+export async function initializeWorkSchema(db,statements){
+ const names=statements.map(sql=>{
+  const match=sql.match(/^CREATE (?:TABLE|TRIGGER) IF NOT EXISTS ([a-z0-9_]+)/);
+  if(!match)throw Error('WORK_SCHEMA_STATEMENT_INVALID');return match[1];
+ });
+ let entries=initialized.get(db);if(!entries){entries=new Map();initialized.set(db,entries);}
+ const key=names.join(',');let ready=entries.get(key);
+ if(!ready){ready=(async()=>{
+  const existing=await db.prepare('SELECT name FROM sqlite_master WHERE name IN ('+names.map(()=>'?').join(',')+')').bind(...names).all();
+  const present=new Set(existing.results.map(row=>row.name));
+  const missing=statements.filter((sql,index)=>!present.has(names[index]));
+  if(missing.length&&migrationOwned.has(db))throw Error('WORK_MIGRATED_SCHEMA_MISSING');
+  if(missing.length)await db.batch(missing.map(sql=>db.prepare(sql)));
+ })();entries.set(key,ready);}
+ try{await ready;}catch(error){entries.delete(key);throw error;}
+}
