+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {build} from 'esbuild';
+import {mkdtemp,readFile,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join,resolve} from 'node:path';
+import {sqliteD1} from './helpers.mjs';
+const dir=await mkdtemp(join(tmpdir(),'fabrya-d1-schema-'));
+const entries=['work-mcp','work-intermediate-preview','work-experience','work-delivery-review'];
+await build({entryPoints:entries.map(p=>'product/'+p+'.mjs'),outdir:dir,bundle:true,format:'esm',platform:'node',plugins:[{name:'raw',setup(b){b.onResolve({filter:/\?raw$/},a=>({path:resolve(a.resolveDir,a.path.slice(0,-4)),namespace:'raw'}));b.onLoad({filter:/.*/,namespace:'raw'},async a=>({contents:await readFile(a.path,'utf8'),loader:'text'}));}}]});
+const modules=await Promise.all(entries.map(p=>import('file://'+join(dir,p+'.js'))));
+const initializers=[modules[0].initializeWork,modules[1].initializeWorkPreviews,modules[2].initializeExperiences,modules[3].initializeWorkReviews];
+test('all initializers on the reception path work without exec and reproduce the existing migration-owned schema',async()=>{
+ const db=sqliteD1(),reference=sqliteD1();try{
+  let execCalls=0,ddl=0;db.exec=async sql=>{execCalls++;for(const line of sql.trim().split('\n'))db.connection.exec(line);};
+  const prepare=db.prepare;db.prepare=sql=>{if(/^CREATE /i.test(sql))ddl++;return prepare(sql);};
+  for(const initialize of initializers)await initialize(db);
+  assert.equal(execCalls,0);assert.equal(ddl,15,'11 tables and 4 canonical immutable triggers');
+  reference.connection.exec(await readFile('product/native-work-schema.sql','utf8'));
+  const schema=database=>database.connection.prepare("SELECT type,name,tbl_name,sql FROM sqlite_master WHERE name LIKE 'fp_work_%' ORDER BY type,name").all().map(row=>({...row,sql:row.sql.replace(/\s+/g,' ').trim()}));
+  assert.deepEqual(schema(db),schema(reference));
+  for(const initialize of initializers)await initialize(db);assert.equal(ddl,15,'repeated initialization never recreates installed objects');
+  assert.equal(execCalls,0);
+ }finally{db.close();reference.close();}
+});
+test.after(async()=>{await rm(dir,{recursive:true,force:true});});
