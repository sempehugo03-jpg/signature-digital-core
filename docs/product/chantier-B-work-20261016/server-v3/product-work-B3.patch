+import {productAuth} from './auth.mjs';
+import {productHandler} from './http.mjs';
+import {workProductAdapter,workDeliveryVerifier} from './work-product-adapter.mjs';
+import {deliveryGate} from './delivery-gate.mjs';
+
+const nativeKey=key=>typeof key==='string'&&/^native_work_[a-f0-9]{64}$/.test(key);
+export {nativeKey};
+// Strengthen the existing verifier for this new intake only. Historical Product
+// routes and receipts are untouched; a preview_only receipt cannot open approval.
+export function nativeWorkDeliveryVerifier(db){
+ const verifier=workDeliveryVerifier(db);
+ return {async verify(input){
+  const row=await db.prepare(`SELECT p.request_key,w.result,l.version_id FROM fp_projects p
+   JOIN fp_work_product_links l ON l.project_id=p.id AND l.user_id=p.user_id
+   JOIN fp_work_mcp_requests w ON w.id=l.request_id
+   WHERE p.id=? AND l.job_id=? AND l.version_id=? AND w.status='completed'`).bind(input.project_id,input.job_id,input.version_id).first();
+  if(!row||!nativeKey(row.request_key))return {verified:false};
+  let receipt;try{receipt=JSON.parse(row.result);}catch{return {verified:false};}
+  const writer=receipt.proof?.publisher_readback;
+  if(receipt.delivery_qualification!=='verified'||receipt.client_artifact_sha256!==input.artifact_hash||
+   writer?.verified!==true||writer.site_project_id!==receipt.site_project_id||writer.sha256!==input.artifact_hash||
+   writer.release_ref!=='work_release_'+row.version_id)return {verified:false};
+  return verifier.verify(input);
+ }};
+}
+// Only owns existing native_work_ projects, never the historical Product list,
+// auth, creation, webhook, credits or engine routes. null means legacy fallback.
+export function nativeWorkProjects({db,env,clock=()=>Date.now()}){
+ const identity=productAuth({db,clock});
+ const verifier=nativeWorkDeliveryVerifier(db);
+ const json=(code,status)=>Response.json({code},{status,headers:{'cache-control':'no-store'}});
+ return async request=>{
+  const url=new URL(request.url);
+  const match=url.pathname.match(/^\/api\/product\/projects\/([^/]+)(.*)$/);
+  const permalink=url.pathname.match(/^\/p\/([^/]+)$/);
+  if(!match&&!permalink)return null;
+  let id=match?.[1];
+  if(permalink){
+   const version=await db.prepare('SELECT project_id FROM fp_versions WHERE id=?').bind(permalink[1]).first();
+   if(!version)return null;id=version.project_id;
+  }
+  const project=await db.prepare('SELECT id,user_id,request_key,status FROM fp_projects WHERE id=?').bind(id).first();
+  if(!project||!nativeKey(project.request_key))return null;
+  // A matching new project is consumed even when unauthorized/unsupported:
+  // never let the deterministic historical handler reconcile this Work job.
+  const user=await identity.user(request);
+  if(!user)return json('SESSION_EXPIRED',401);
+  if(project.user_id!==user.id)return json('NOT_FOUND',404);
+  const tail=match?.[2]||'';
+  const read=request.method==='GET'&&(permalink||tail===''||/^\/versions\/[^/]+\/preview$/.test(tail)||tail==='/work-previews'||/^\/work-previews\/[^/]+\/preview$/.test(tail));
+  const approve=request.method==='POST'&&tail==='/approve';
+  if(!read&&!approve){
+   if(/^\/(checkout|payment|portal|changes|publish|restore|credits)(\/|$)/.test(tail))return json('NATIVE_WORK_COMMERCE_LOCKED',409);
+   return json('NATIVE_WORK_ROUTE_UNAVAILABLE',405);
+  }
+  if(approve){
+   if(request.headers.get('origin')!==url.origin||!['','same-origin','none'].includes(request.headers.get('sec-fetch-site')||''))return json('ORIGIN',403);
+   // Approval of an activated project can publish in the historical service.
+   // Native B3 never enters that path, even if a row was incorrectly activated.
+   const active=await db.prepare('SELECT 1 present FROM fp_activations WHERE project_id=? UNION ALL SELECT 1 FROM fp_subscriptions WHERE project_id=? LIMIT 1').bind(id,id).first();
+   if(project.status==='active'||active)return json('POSTPURCHASE_ROUTE_REQUIRED',409);
+   const raw=await request.clone().text();if(new TextEncoder().encode(raw).length>24000)return json('TOO_LARGE',413);
+   let body;try{body=JSON.parse(raw);}catch{return json('INVALID_REQUEST',400);}
+   if(!body||typeof body!=='object'||Array.isArray(body)||typeof body.version_id!=='string')return json('INVALID_REQUEST',400);
+   const version=await db.prepare("SELECT * FROM fp_versions WHERE id=? AND project_id=? AND state='ready'").bind(body?.version_id,id).first();
+   if(!version)return json('NOT_FOUND',404);
+   const gate=await deliveryGate({db,version,verifier});
+   if(!gate.checkout_allowed)return json('DELIVERY_NOT_VALIDATED',409);
+  }
+  // No generator/billing replacement: canonical Product routes, explicitly Work.
+  return productHandler({db,env,clock,auth:{...identity,user:async()=>user},
+   kevin:workProductAdapter({db,clock}),deliveryVerifier:verifier})(request);
+ };
+}
