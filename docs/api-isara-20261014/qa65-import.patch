+// Import of one existing API artifact into the existing Product importer.
+// No provider call, Work queue, payment, session minting or site publication.
+import {productService} from './service.mjs';
+import {digest,fail} from './contract.mjs';
+import {qaScenarioIdentity} from './qa-work-creation.mjs';
+export const ISARA = Object.freeze({experiment:'api-direct-20261014-v1',sha256:'d15cc7fc6b8db227c56f7e3e12e3a753c265f7dedf4f95a78af5c4f68e59fd74',bytes:66832,site:'appgprj_6acfc1f20c048191851fbde3c3714152',site_version:'appgprj_6acfc1f20c048191851fbde3c3714152~appgver_663a1b53ad488191b0f45eb90eca4283',url:'https://isara-api-experiment.sempehugo03.chatgpt.site',source:'openai-api',cost_usd:'1.821245',paid_calls:2,provider_responses:['resp_0bb18cabe34816ba006acfbaa6673487d29e824941dc35ea9a','resp_0bb18cabe34816ba006acfc0c7e56887d29a69cf1cbbc5f253']});
+const origin='https://fabrya-product-qa.sempehugo03.chatgpt.site';
+const ownerId='6c57d6df-7197-4cfc-9e1c-8c0acebea109',ownerEmail='sempehugo03@gmail.com';
+const key='isara_api_existing_import_20261014';
+export async function initializeApiImports(db){
+ await db.prepare(`CREATE TABLE IF NOT EXISTS fp_api_imports(experiment TEXT PRIMARY KEY,project_id TEXT NOT NULL UNIQUE,user_id TEXT NOT NULL,artifact_hash TEXT NOT NULL,site_project_id TEXT NOT NULL,site_version_id TEXT NOT NULL,demo_url TEXT NOT NULL,source TEXT NOT NULL CHECK(source='openai-api'),created_at TEXT NOT NULL)`).run();
+ await db.prepare(`CREATE TRIGGER IF NOT EXISTS fp_api_imports_immutable_update BEFORE UPDATE ON fp_api_imports BEGIN SELECT RAISE(ABORT,'immutable_api_import'); END`).run();
+ await db.prepare(`CREATE TRIGGER IF NOT EXISTS fp_api_imports_immutable_delete BEFORE DELETE ON fp_api_imports BEGIN SELECT RAISE(ABORT,'immutable_api_import'); END`).run();
+}
+export async function apiProject(db,id){
+ const table=await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='fp_api_imports'").first();
+ return table?db.prepare('SELECT * FROM fp_api_imports WHERE project_id=?').bind(id).first():null;
+}
+async function checkedHtml(html){
+ if(typeof html!=='string'||new TextEncoder().encode(html).byteLength!==ISARA.bytes||await digest(html)!==ISARA.sha256)fail('API_ARTIFACT_MISMATCH','La démo originale ne correspond pas au reçu API.',503);
+ return html;
+}
+export function apiIsaraAdapter({db,html}){
+ async function bound(job_id){const row=await db.prepare(`SELECT j.id,j.project_id,j.version_id,v.source,i.user_id FROM fp_jobs j JOIN fp_versions v ON v.id=j.version_id JOIN fp_api_imports i ON i.project_id=j.project_id JOIN fp_projects p ON p.id=i.project_id AND p.user_id=i.user_id WHERE j.id=? AND i.experiment=? AND i.artifact_hash=?`).bind(job_id,ISARA.experiment,ISARA.sha256).first();if(!row||row.source!==ISARA.source)fail('API_IMPORT_BINDING','Import API non associé à ce projet.',409);return row;}
+ return {kind:ISARA.source,async createDemo(input){if(input.revision)fail('API_EXPERIMENT_FROZEN','Cette démo expérimentale est conservée sans nouvelle génération.',409);const row=await bound(input.job_id);await checkedHtml(html);return {job_id:row.id,handle:JSON.stringify({source:ISARA.source,experiment:ISARA.experiment,job_id:row.id})};},async getJob({job_id,handle}){const row=await bound(job_id);let h;try{h=JSON.parse(handle);}catch{}if(h?.source!==ISARA.source||h?.experiment!==ISARA.experiment||h?.job_id!==row.id)fail('API_IMPORT_HANDLE','Import API invalide.',409);return {status:'ready',recoverable:false,progress:{stage:'ready',label:'ISARA importée depuis l’API · contrôles visuels à compléter'},result:{html:await checkedHtml(html),hash:ISARA.sha256,source:ISARA.source,mock:false}};},async cancel(){fail('API_EXPERIMENT_FROZEN','La démo existante reste conservée.',409);}};
+}
+export async function importIsara({db,user,html}){
+ if(user?.email!==ownerEmail)fail('API_OWNER_REQUIRED','Import réservé au compte propriétaire autorisé.',403);
+ await checkedHtml(html);await initializeApiImports(db);
+ const id='prj_'+(await digest(user.id+':'+key)).slice(0,32);
+ await db.prepare(`INSERT OR IGNORE INTO fp_api_imports VALUES(?,?,?,?,?,?,?,?,?)`).bind(ISARA.experiment,id,user.id,ISARA.sha256,ISARA.site,ISARA.site_version,ISARA.url,ISARA.source,new Date().toISOString()).run();
+ const row=await apiProject(db,id);if(!row||row.user_id!==user.id||row.artifact_hash!==ISARA.sha256||row.experiment!==ISARA.experiment)fail('API_IMPORT_OWNER_CONFLICT','Cette création appartient déjà à un autre projet.',409);
+ const service=productService({db,kevin:apiIsaraAdapter({db,html}),qa:true});
+ await service.create(user,{request_key:key,company_input:{name:'ISARA — expérience API',activity:'Atelier de parfumerie fictif',location:'Tarbes',objective:'Préparer une intention de consultation à partir d’un souvenir.',description:'Démo expérimentale déjà générée par API OpenAI. Aucune nouvelle génération ni réservation.'}});
+ await service.requestDemo(user,id,{request_key:'isara_api_artifact_import_v1'});
+ const result=await service.read(user,id),version=result.versions.find(v=>v.artifact_hash===ISARA.sha256&&v.source===ISARA.source);
+ if(!version)fail('API_IMPORT_INCOMPLETE','Import conservé, vérification à reprendre.',503);
+ return {project_id:id,user_id:user.id,version_id:version.id,job_id:result.job.job_id,source:ISARA.source,artifact_sha256:version.artifact_hash,project_status:result.project.status,preview_path:`/api/product/projects/${id}/versions/${version.id}/preview`,workspace_url:origin+'/produit?project='+id,qualification:'preview_only',experiment:ISARA.experiment,provider_response_ids:ISARA.provider_responses,cost_usd:ISARA.cost_usd,new_paid_calls:0,work_request_created:false,payment_performed:false};
+}
+export async function apiIsaraAdmin({db,request,owner,env,input}){
+ if(new URL(request.url).origin!==origin||env.FABRYA_PRODUCT_QA!=='true'||env.FABRYA_STRIPE_MODE!=='test'||owner!==ownerId||request.headers.get('oai-authenticated-user-id')!==owner||request.headers.get('cookie')||request.headers.has('oai-sites-authorization'))fail('API_ADMIN_REQUIRED','Administrateur privé authentifié requis.',403);
+ if(!['status','import','verify'].includes(input.action)||Object.keys(input).some(k=>!['origin','action'].includes(k)))fail('API_OPERATION_INVALID','Action API expérimentale invalide.',400);
+ const user=await db.prepare("SELECT id,email FROM sd_platform_users WHERE email=? AND status='active'").bind(ownerEmail).first();
+ if(!user)return {status:'OWNER_ACCOUNT_UNAVAILABLE',delivered:false,new_paid_calls:0};
+ const table=await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='fp_api_imports'").first();
+ let row=table?await db.prepare('SELECT * FROM fp_api_imports WHERE experiment=?').bind(ISARA.experiment).first():null;
+ if(input.action==='status')return {status:row?'IMPORTED':'NOT_IMPORTED',project_id:row?.project_id||null,owner_account_available:true,source:ISARA.source,new_paid_calls:0};
+ if(input.action==='import')return importIsara({db,user,html:env.FABRYA_ISARA_EXISTING_HTML});
+ if(!row||row.user_id!==user.id)fail('API_IMPORT_MISSING','Import API absent du compte autorisé.',404);
+ const service=productService({db,kevin:apiIsaraAdapter({db,html:env.FABRYA_ISARA_EXISTING_HTML}),qa:true});
+ const data=await service.read(user,row.project_id),version=data.versions.find(v=>v.source===ISARA.source&&v.artifact_hash===ISARA.sha256);
+ const artifact=await service.version(user,row.project_id,version.id);
+ if(await digest(artifact.html)!==ISARA.sha256)fail('API_PREVIEW_MISMATCH','Aperçu différent de la création originale.',503);
+ const credential=await qaScenarioIdentity('isara-foreign-isolation-20261014',env.FABRYA_QA_CREATION_PASSWORD);
+ let cookie='';const call=async(path,method='GET',body)=>{const response=await env.FABRYA_QA_PRODUCT_FETCH(new Request(origin+'/api/product/'+path,{method,headers:{origin,cookie,...(body?{'content-type':'application/json'}:{})},body:body?JSON.stringify(body):undefined}));const ck=response.headers.get('set-cookie')?.match(/fabrya_session=[^;,]+/);if(ck)cookie=ck[0];return response;};
+ let r=await call('auth/register','POST',{...credential,name:'Client fictif — isolation ISARA'});if(![201,409].includes(r.status))fail('API_QA_REGISTER','Compte de test indisponible.',503);
+ r=await call('auth/login','POST',credential);if(r.status!==200)fail('API_QA_LOGIN','Connexion du client de contrôle refusée.',503);
+ const foreign=(await r.json()).user;if(foreign.id===user.id)fail('API_QA_IDENTITY','Identités de test confondues.',503);
+ const base='projects/'+row.project_id;
+ const denied={project:(await call(base)).status,preview:(await call(base+'/versions/'+version.id+'/preview')).status,conversation:(await call(base+'/conversation')).status,approval:(await call(base+'/approve','POST',{version_id:version.id,artifact_hash:ISARA.sha256})).status};
+ if(Object.values(denied).some(s=>s!==404))fail('API_ISOLATION_FAILED','Un accès croisé doit être refusé.',503);
+ await call('auth/logout','POST',{});cookie='';const anonymous=(await call(base+'/versions/'+version.id+'/preview')).status;
+ if(anonymous!==401)fail('API_ANONYMOUS_FAILED','Aperçu disponible sans session.',503);
+ const provenance=await db.prepare('SELECT adapter_kind,result_source,is_mock FROM fp_version_delivery WHERE version_id=?').bind(version.id).first();
+ const counts=await db.prepare('SELECT count(*) n FROM fp_jobs WHERE project_id=?').bind(row.project_id).first();
+ const work=await db.prepare('SELECT count(*) n FROM fp_work_product_links WHERE project_id=?').bind(row.project_id).first();
+ if(provenance?.adapter_kind!==ISARA.source||provenance.result_source!==ISARA.source||provenance.is_mock!==0||counts.n!==1||work.n!==0)fail('API_PROVENANCE_FAILED','Provenance API à vérifier.',503);
+ return {status:'verified',project_id:row.project_id,version_id:version.id,owner_scoped_preview_sha256:await digest(artifact.html),owner_browser_session:'NOT_VERIFIED',foreign_http:denied,anonymous_preview_http:anonymous,provenance,job_count:counts.n,work_binding_count:work.n,browser:'NOT_VERIFIED',new_paid_calls:0,payment_performed:false};
+}
