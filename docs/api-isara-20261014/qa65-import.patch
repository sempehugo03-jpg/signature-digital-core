+const html=readFileSync(new URL('../../product/assets/isara-api-original.html',import.meta.url),'utf8');
+const origin='https://fabrya-product-qa.sempehugo03.chatgpt.site';
+function setup(){const db=sqliteD1();db.connection.exec(readFileSync(new URL('../../product/drizzle/0004_private_delivery_gate.sql',import.meta.url),'utf8'));return db;}
+async function accounts(db){const auth=productAuth({db});const r=new Request(origin+'/api/product/auth/register');const a=await auth.register(r,{email:'sempehugo03@gmail.com',name:'Owner',password:'local-fixture-owner-only'});const b=await auth.register(r,{email:'isara-other@example.test',name:'Foreign',password:'local-fixture-foreign-only'});return {a,b,auth,r};}
+function request(db,cookie,path,method='GET',body){return productHandler({db,env:{FABRYA_PRODUCT_QA:'true',FABRYA_PRODUCT_ORIGIN:origin,FABRYA_ISARA_EXISTING_HTML:html},kevin:apiIsaraAdapter({db,html})})(new Request(origin+'/api/product/'+path,{method,headers:{origin,cookie,...(body?{'content-type':'application/json'}:{})},body:body?JSON.stringify(body):undefined}));}
+test('existing Product importer keeps exact API bytes, is idempotent and never records Work provenance',async()=>{const db=setup();try{const {a}=await accounts(db);const first=await importIsara({db,user:a.user,html}),again=await importIsara({db,user:a.user,html});assert.deepEqual(first,again);const row=await db.prepare('SELECT * FROM fp_version_delivery WHERE version_id=?').bind(first.version_id).first();assert.equal(row.adapter_kind,'openai-api');assert.equal(row.result_source,'openai-api');assert.equal(row.is_mock,0);assert.equal((await db.prepare('SELECT count(*) n FROM fp_jobs').first()).n,1);assert.equal((await db.prepare("SELECT count(*) n FROM sqlite_master WHERE name='fp_work_mcp_requests'").first()).n,0);assert.equal(new TextEncoder().encode(html).byteLength,66832);await assert.rejects(importIsara({db,user:a.user,html:html+' '}),e=>e.code==='API_ARTIFACT_MISMATCH');assert.equal((await db.prepare('SELECT count(*) n FROM fp_versions').first()).n,1);}finally{db.close();}});
+test('real password sessions: owner HTTP preview exact; foreign project/preview/approval/conversation 404; anonymous 401; logout and relogin persist',async()=>{const db=setup();try{const {a,b,auth,r}=await accounts(db);const delivery=await importIsara({db,user:a.user,html});const base='projects/'+delivery.project_id,preview=base+'/versions/'+delivery.version_id+'/preview';const cookie=x=>x.cookie.split(';')[0];let response=await request(db,cookie(a),preview);assert.equal(response.status,200);assert.equal(await response.text(),html);assert.match(response.headers.get('content-security-policy'),/sandbox allow-scripts allow-forms allow-downloads/);assert.match(response.headers.get('content-security-policy'),/connect-src 'none'/);for(const path of [base,preview,base+'/conversation'])assert.equal((await request(db,cookie(b),path)).status,404);assert.equal((await request(db,cookie(b),base+'/approve','POST',{version_id:delivery.version_id})).status,404);assert.equal((await request(db,'',preview)).status,401);assert.equal((await request(db,cookie(a),base+'/approve','POST',{version_id:delivery.version_id})).status,409);assert.equal((await request(db,cookie(a),base+'/conversation','POST',{action:'revise',message:'new',request_key:'local_isara_no_regeneration'})).status,409);await request(db,cookie(a),'auth/logout','POST',{});assert.equal((await request(db,cookie(a),preview)).status,401);const logged=await auth.login(r,{email:a.user.email,password:'local-fixture-owner-only'});assert.equal(await (await request(db,cookie(logged),preview)).text(),html);const data=await (await request(db,cookie(logged),base+'/conversation')).json();const view=conversationView(data);assert.match(view,/Création par API OpenAI/);assert.match(view,/reste à vérifier/);assert.doesNotMatch(view,/Demander cet ajustement|vérifiée sur ordinateur/);}finally{db.close();}});
+test('private API admin rejects untrusted caller before DB or provider access',async()=>{let touched=false;await assert.rejects(apiIsaraAdmin({db:{prepare(){touched=true;throw Error();}},request:new Request(origin+'/mcp'),owner:'wrong',env:{FABRYA_PRODUCT_QA:'true',FABRYA_STRIPE_MODE:'test'},input:{action:'import'}}),e=>e.code==='API_ADMIN_REQUIRED');assert.equal(touched,false);});
