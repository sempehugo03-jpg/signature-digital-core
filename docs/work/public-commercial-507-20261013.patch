+// Reopen only after the PR #205 owner-bound delivery and Stripe TEST gates pass.
+// A browser flag or an environment variable cannot bypass this publication decision.
+export const COMMERCIAL_LAUNCH = Object.freeze({ newOrdersEnabled: false, paymentsEnabled: false })
+export const COMMERCIAL_UNAVAILABLE = 'Les nouvelles commandes et les paiements sont temporairement désactivés pendant la validation de la livraison. Aucun paiement ne vous est demandé. Contact : contact@fabrya.fr.'
+export function unavailableCommercialResponse() {
+  return Response.json({ ok: false, code: 'DELIVERY_NOT_VALIDATED', message: COMMERCIAL_UNAVAILABLE }, { status: 503, headers: { 'cache-control': 'no-store' } })
+}
