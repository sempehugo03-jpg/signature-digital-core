@@ -0,0 +1,42 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+function load(file, dependencies = {}, globals = {}) {
+  const output = ts.transpileModule(readFileSync(new URL('../' + file, import.meta.url), 'utf8'), { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 } }).outputText;
+  const exports = {};
+  vm.runInNewContext(output, { exports, Response, Request, ...globals, require(name) {
+    if (name in dependencies) return dependencies[name];
+    return new Proxy({}, { get() { throw new Error('Unexpected external dependency: ' + name); } });
+  } }, { filename: file });
+  return exports;
+}
+const launch = load('src/lib/commercialLaunch.ts');
+for (const path of ['app/api/client-projects/route.ts', 'app/api/create-checkout-session/route.ts', 'app/api/credits/checkout/route.ts']) {
+  test(path + ' rejects new orders without DB, Stripe or body access', async () => {
+    const route = load(path, { '@/src/lib/commercialLaunch': launch });
+    for (const body of [{ projectId: 'fictional-owner-project', activationToken: 'sdp_fake', packId: '100' }, { projectId: 'other-account-project' }]) {
+      const request = new Request('https://fabrya.fr/api', { method: 'POST', body: JSON.stringify(body), headers: { origin: 'https://fabrya.fr', 'content-type': 'application/json' } });
+      request.json = () => { throw new Error('Body must not be consumed while closed'); };
+      const result = await route.POST(request);
+      assert.equal(result.status, 503);
+      assert.equal(result.headers.get('cache-control'), 'no-store');
+      const payload = await result.json();
+      assert.equal(payload.code, 'DELIVERY_NOT_VALIDATED');
+      assert.equal(payload.ok, false);
+      assert.equal(payload.url, undefined);
+    }
+  });
+}
+test('new offer 59 EUR preserves existing captured subscription terms', () => {
+  const store = load('src/data/commercialOfferStore.ts');
+  assert.equal(store.readActiveCommercialOffer().recurringAmount, 5900);
+  const previous = { offerId: 'fabrya-standard-90', name: 'FABRYA', installationAmount: 0, recurringAmount: 9000, currency: 'EUR', recurringInterval: 'month' };
+  assert.equal(store.resolveCommercialOfferForProject({ status: 'active', commercialOfferSnapshot: previous }).recurringAmount, 9000);
+  assert.equal(store.resolveCommercialOfferForProject({ status: 'request_received', commercialOfferSnapshot: previous }).recurringAmount, 5900);
+});
+test('retired browser default cannot advertise 90 EUR to a new customer', () => {
+  const store = load('src/data/commercialOfferStore.ts', {}, { window: { localStorage: { getItem: () => JSON.stringify({ id: 'fabrya-standard-90', recurringAmount: 9000 }) } } });
+  assert.equal(store.readActiveCommercialOffer().recurringAmount, 5900);
+});
