+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {sqliteD1} from './helpers.mjs';
+import {initializePrivateChanges} from '../../product/change-migration.mjs';
+import {productHandler} from '../../product/http.mjs';
+import {qaFreeIntake} from '../../product/qa-free-intake.mjs';
+import {initializeApiImports} from '../../product/api-isara-import.mjs';
+import {creationCapabilities} from '../../product/creation-capabilities.mjs';
+const origin='https://fabrya-product-qa.sempehugo03.chatgpt.site',owner='FekXMbXF2XEpsFhoewe0s3oxeXCh84oz7wBCoPaIein51fFOX5GWbI';
+test('free intake uses real password sessions and persists a new company conversation without invoking any creator or granting credits',async()=>{const db=sqliteD1();try{db.connection.exec(readFileSync(new URL('../../product/drizzle/0004_private_delivery_gate.sql',import.meta.url),'utf8'));const env={FABRYA_PRODUCT_QA:'true',FABRYA_PRODUCT_ORIGIN:origin,FABRYA_STRIPE_MODE:'test',FABRYA_CREDITS_ENABLED:'true',FABRYA_QA_CREATION_PASSWORD:'local-fixture-credential-only'};await initializePrivateChanges(db,env);await initializeApiImports(db);let creatorCalls=0;const handler=productHandler({db,env,kevin:{kind:'work-mcp',createDemo(){creatorCalls++;throw Error('No generation authorized');}}});env.FABRYA_QA_PRODUCT_FETCH=handler;const args={db,env,owner,request:new Request(origin+'/mcp',{method:'POST',headers:{'oai-authenticated-user-id':owner}})};const result=await qaFreeIntake(args);assert.equal(result.status,'PASS');assert.equal(result.conversation_preserved_after_relogin,true);assert.equal(result.job_count,0);assert.equal(result.credits,0);assert.equal(creatorCalls,0);assert.equal(result.capabilities.api.automatic_new_company,false);const replay=await qaFreeIntake(args);assert.equal(replay.project_id,result.project_id);assert.equal((await db.prepare('SELECT count(*) n FROM fp_projects').first()).n,1);assert.equal((await db.prepare("SELECT count(*) n FROM fp_conversation_messages WHERE role='user' AND origin='customer'").first()).n,1);}finally{db.close();}});
+test('capability audit reports a stored runtime interruption rather than assuming a running generator',async()=>{const db=sqliteD1();try{db.connection.exec('CREATE TABLE fp_work_mcp_requests(checkpoint TEXT,updated_at TEXT)');db.connection.prepare('INSERT INTO fp_work_mcp_requests VALUES(?,?)').run(JSON.stringify({phase:'BLOCKED_RUNTIME'}),'2026-10-14T15:49:27.805Z');const state=await creationCapabilities(db);assert.equal(state.work.runtime.state,'BLOCKED_RUNTIME');assert.equal(state.work.runtime.observed_at,'2026-10-14T15:49:27.805Z');assert.equal(state.full_client_loop_verified,false);assert.equal(state.api.automatic_publication,false);}finally{db.close();}});
