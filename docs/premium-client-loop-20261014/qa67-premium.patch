@@ -0,0 +1,14 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {scopedDraft} from '../../product/draft-storage.mjs';
+test('a reload restores only the authenticated owner/project draft and clearing it preserves other projects',()=>{
+ const values=new Map(),storage={getItem:k=>values.get(k),setItem:(k,v)=>values.set(k,v),removeItem:k=>values.delete(k)};
+ const a=scopedDraft(storage,'owner_user_a','project_123456'),b=scopedDraft(storage,'owner_user_b','project_123456'),other=scopedDraft(storage,'owner_user_a','project_654321');
+ a.save('Changer mes horaires à 09:15');other.save('Une autre demande');
+ assert.equal(scopedDraft(storage,'owner_user_a','project_123456').load(),'Changer mes horaires à 09:15');assert.equal(b.load(),'');a.clear();assert.equal(a.load(),'');assert.equal(other.load(),'Une autre demande');
+});
+test('draft storage fails closed for missing scope and remains usable when browser persistence is denied',()=>{
+ assert.throws(()=>scopedDraft({},'', 'project_123456'),/SCOPE/);
+ const blocked={getItem(){throw Error('denied');},setItem(){throw Error('denied');},removeItem(){throw Error('denied');}};
+ const draft=scopedDraft(blocked,'owner_user_a','project_123456');assert.equal(draft.load(),'');assert.doesNotThrow(()=>draft.save('Mon texte'));assert.doesNotThrow(()=>draft.clear());
+});
